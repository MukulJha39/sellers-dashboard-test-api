NODE_ENV=development
PORT=4100
API_PREFIX=/api/v1

MONGODB_URI=mongodb://127.0.0.1:27017/sellersdash

# Use long random values in any non-development environment
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_32chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_32chars_min
JWT_REGISTRATION_SECRET=dev_registration_secret_change_me_32chars_min
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
REGISTRATION_TOKEN_TTL=900

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_PHONE_PER_HOUR=5
# development only: returns the OTP in the API response so the flow is testable without an SMS provider
OTP_EXPOSE_IN_RESPONSE=true

SMS_PROVIDER=console

CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
PUBLIC_BASE_URL=http://localhost:4100
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

SEED_SUPER_ADMIN_EMAIL=admin@sellersdash.local
# Quote any value containing "#": dotenv treats an unquoted # as an inline comment.
SEED_SUPER_ADMIN_PASSWORD="ChangeMe#12345"
SEED_SUPER_ADMIN_NAME=Super Admin
